# .env.example — copy sang .env rồi điền giá trị thật. .env đã gitignore,
# KHÔNG commit file .env thật (chứa API key/mật khẩu).
#
# Dùng với `docker compose` (đọc qua `env_file:` của service `app`) hoặc
# `docker run --env-file .env`. Xem docstring đầu scripts/run_news_service.py
# cho mô tả đầy đủ từng biến.

# --- Bắt buộc ---
# Với docker-compose: ĐỪNG sửa hai biến DSN/Kafka bootstrap ở đây — chúng đã
# được ghi đè bởi `environment:` của service `app` trong docker-compose.yml
# (trỏ vào service postgres/kafka nội bộ mạng compose). Hai dòng dưới chỉ
# dùng khi chạy `docker run` ĐƠN LẺ (không qua docker-compose), trỏ vào
# Postgres/Kafka của bạn.
GPR_DB_DSN=postgresql://user:pass@host:5432/dbname
GPR_KAFKA_BOOTSTRAP=host1:9092,host2:9092

OPENAI_API_KEY=sk-...
GPR_TRAINING_CUTOFF=2026-01-01

# --- Tuỳ chọn (có mặc định hợp lý, xem docstring run_news_service.py) ---
# OPENAI_BASE_URL=                 # trỏ endpoint OpenAI-compatible khác
# GPR_LLM_MODEL=gpt-4o-mini
# GPR_MODEL_VERSION=               # mặc định = GPR_LLM_MODEL
# GPR_KAFKA_GROUP=gpr-news-service
# GPR_KAFKA_TOPIC_IN=gpr.news.raw
# GPR_KAFKA_TOPIC_OUT=gpr.news.assessment
# GPR_GAMMA_REPORTS_DIR=docs/reports
